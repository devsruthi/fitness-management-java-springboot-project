{
  "info": {
    "name": "Health Club Operations REST API",
    "description": "Import into Postman (File → Import). Start the Spring Boot app first so requests go to http://localhost:8080.\n\nSuggested order: List plans → List service types → List members → Login → then write operations.\n\nSeed login: arun.kumar@example.com / Arun@123\nPending subscription for purchase: subscriptionId 35 (member 31).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "memberId", "value": "1" },
    { "key": "planId", "value": "1" },
    { "key": "subscriptionId", "value": "35" },
    { "key": "sessionId", "value": "1" }
  ],
  "item": [
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "List active plans",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/subscription-plans"
          }
        },
        {
          "name": "List service types",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/service-types"
          }
        },
        {
          "name": "List scheduled sessions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sessions"
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List all members",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members"
          }
        },
        {
          "name": "Register member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Tester\",\n  \"emailId\": \"alex.tester@example.com\",\n  \"password\": \"Alex@123\",\n  \"phoneNo\": \"1511111111\",\n  \"dateOfBirth\": \"1998-05-12\"\n}"
            },
            "url": "{{baseUrl}}/api/members/register"
          }
        },
        {
          "name": "Login member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailId\": \"arun.kumar@example.com\",\n  \"password\": \"Arun@123\"\n}"
            },
            "url": "{{baseUrl}}/api/members/login"
          }
        },
        {
          "name": "Get member",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members/{{memberId}}"
          }
        }
      ]
    },
    {
      "name": "Subscription plans (admin)",
      "item": [
        {
          "name": "Get plan (admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/subscription-plans/{{planId}}"
          }
        },
        {
          "name": "Create plan (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"Trial\",\n  \"durationInMonths\": 1,\n  \"planPrice\": 9.99,\n  \"planDescription\": \"One month trial plan\",\n  \"planStatus\": \"ACTIVE\",\n  \"groupClassesAccess\": true,\n  \"personalTrainingAccess\": false,\n  \"exclusiveServices\": false\n}"
            },
            "url": "{{baseUrl}}/api/admin/subscription-plans"
          }
        },
        {
          "name": "Update plan (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"Classic Plus\",\n  \"durationInMonths\": 1,\n  \"planPrice\": 34.99,\n  \"planDescription\": \"Updated classic plan\",\n  \"planStatus\": \"ACTIVE\",\n  \"groupClassesAccess\": true,\n  \"personalTrainingAccess\": false,\n  \"exclusiveServices\": false\n}"
            },
            "url": "{{baseUrl}}/api/admin/subscription-plans/{{planId}}"
          }
        },
        {
          "name": "Deactivate plan (admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/subscription-plans/{{planId}}"
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Add subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/members/{{memberId}}/subscriptions"
          }
        },
        {
          "name": "Purchase subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\"\n}"
            },
            "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/purchase"
          }
        }
      ]
    },
    {
      "name": "Sessions and bookings",
      "item": [
        {
          "name": "Book session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/members/{{memberId}}/bookings"
          }
        },
        {
          "name": "List member bookings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members/{{memberId}}/bookings"
          }
        },
        {
          "name": "Cancel session",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/cancel"
          }
        }
      ]
    }
  ]
}

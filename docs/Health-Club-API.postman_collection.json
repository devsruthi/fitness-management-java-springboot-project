{
  "info": {
    "name": "Health Club Operations REST API",
    "description": "Import into Postman (File → Import). Restart the Spring Boot app after pulling these routes.\n\nMember lookup routes:\n- GET /api/members/{{memberId}}/subscriptions/current\n- GET /api/members/{{memberId}}/bookings/upcoming\n- GET /api/members/{{memberId}}/bookings/cancelled\n- GET /api/members/{{memberId}}/payments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "memberId", "value": "1" },
    { "key": "planId", "value": "1" },
    { "key": "subscriptionId", "value": "35" },
    { "key": "sessionId", "value": "1" },
    { "key": "bookingId", "value": "1" },
    { "key": "days", "value": "7" }
  ],
  "item": [
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "List active plans",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/subscription-plans" }
        },
        {
          "name": "List service types",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/service-types" }
        },
        {
          "name": "List all members",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members" }
        },
        {
          "name": "List scheduled sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/sessions" }
        },
        {
          "name": "List all bookings",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/bookings" }
        }
      ]
    },
    {
      "name": "Member workflow",
      "item": [
        {
          "name": "Register member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.memberId) { pm.collectionVariables.set('memberId', String(json.memberId)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Tester\",\n  \"emailId\": \"alex.tester@example.com\",\n  \"password\": \"Alex@123\",\n  \"phoneNo\": \"1511111111\",\n  \"dateOfBirth\": \"1998-05-12\"\n}"
            },
            "url": "{{baseUrl}}/api/members/register"
          }
        },
        {
          "name": "Login member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.memberId) { pm.collectionVariables.set('memberId', String(json.memberId)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailId\": \"alex.tester@example.com\",\n  \"password\": \"Alex@123\"\n}"
            },
            "url": "{{baseUrl}}/api/members/login"
          }
        },
        {
          "name": "Add subscription",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.subscriptionId) { pm.collectionVariables.set('subscriptionId', String(json.subscriptionId)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"planId\": 1\n}" },
            "url": "{{baseUrl}}/api/members/{{memberId}}/subscriptions"
          }
        },
        {
          "name": "Purchase subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\"\n}" },
            "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/purchase"
          }
        },
        {
          "name": "Book a session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.bookingId) { pm.collectionVariables.set('bookingId', String(json.bookingId)); }",
                  "if (json.sessionId) { pm.collectionVariables.set('sessionId', String(json.sessionId)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sessionId\": 1\n}" },
            "url": "{{baseUrl}}/api/members/{{memberId}}/bookings"
          }
        },
        {
          "name": "Get current subscription",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members/{{memberId}}/subscriptions/current"
          }
        },
        {
          "name": "Get upcoming bookings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members/{{memberId}}/bookings/upcoming"
          }
        },
        {
          "name": "Get cancelled bookings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members/{{memberId}}/bookings/cancelled"
          }
        },
        {
          "name": "Get payment history",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members/{{memberId}}/payments"
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List all members",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members" }
        },
        {
          "name": "List members with active subscription",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members/active-subscriptions" }
        },
        {
          "name": "List members expiring soon",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members/expiring-soon?days={{days}}"
          }
        },
        {
          "name": "Get member",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members/{{memberId}}" }
        },
        {
          "name": "Delete member",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/members/{{memberId}}" }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Scheduled upcoming sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/sessions/upcoming" }
        },
        {
          "name": "Completed sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/sessions/completed" }
        },
        {
          "name": "Cancelled sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/sessions/cancelled" }
        },
        {
          "name": "Cancel session",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/sessions/{{sessionId}}/cancel" }
        },
        {
          "name": "Delete session",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/sessions/{{sessionId}}" }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "List member bookings",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members/{{memberId}}/bookings" }
        },
        {
          "name": "List member cancelled bookings",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members/{{memberId}}/bookings/cancelled" }
        },
        {
          "name": "Cancel booking by member",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/members/{{memberId}}/bookings/{{bookingId}}/cancel" }
        }
      ]
    },
    {
      "name": "Dashboard (admin)",
      "item": [
        {
          "name": "Most booked service types",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/dashboard/most-booked-service-types" }
        },
        {
          "name": "Most cancelled sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/dashboard/most-cancelled-sessions" }
        },
        {
          "name": "Revenue per month",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/dashboard/revenue/monthly" }
        },
        {
          "name": "Revenue per month for a year",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/dashboard/revenue/monthly?year=2026" }
        },
        {
          "name": "Revenue per year",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/dashboard/revenue/yearly" }
        }
      ]
    }
  ]
}

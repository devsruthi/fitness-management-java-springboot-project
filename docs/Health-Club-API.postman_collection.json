{
  "info": {
    "name": "Health Club Operations REST API",
    "description": "Import into Postman (File → Import). Restart the Spring Boot app after pulling these routes.\n\nIDs are query parameters. Open Params and set memberId, subscriptionId, sessionId, bookingId, days, month, or year.\n\nMember lookup routes:\n- GET /api/members/subscriptions/current?memberId=\n- GET /api/members/bookings/upcoming?memberId=\n- GET /api/members/bookings/cancelled?memberId=\n- GET /api/members/payments?memberId=",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "memberId", "value": "1" },
    { "key": "planId", "value": "1" },
    { "key": "subscriptionId", "value": "35" },
    { "key": "sessionId", "value": "1" },
    { "key": "bookingId", "value": "1" },
    { "key": "days", "value": "7" },
    { "key": "month", "value": "3" },
    { "key": "year", "value": "2026" }
  ],
  "item": [
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "List active plans",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/subscription-plans" }
        },
        {
          "name": "List service types",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/service-types" }
        },
        {
          "name": "List all members",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members" }
        },
        {
          "name": "List scheduled sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/sessions" }
        },
        {
          "name": "List all bookings",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/bookings" }
        }
      ]
    },
    {
      "name": "Member workflow",
      "item": [
        {
          "name": "Register member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.memberId) { pm.collectionVariables.set('memberId', String(json.memberId)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Tester\",\n  \"emailId\": \"alex.tester@example.com\",\n  \"password\": \"Alex@123\",\n  \"phoneNo\": \"1511111111\",\n  \"dateOfBirth\": \"1998-05-12\"\n}"
            },
            "url": "{{baseUrl}}/api/members/register"
          }
        },
        {
          "name": "Login member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.memberId) { pm.collectionVariables.set('memberId', String(json.memberId)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailId\": \"alex.tester@example.com\",\n  \"password\": \"Alex@123\"\n}"
            },
            "url": "{{baseUrl}}/api/members/login"
          }
        },
        {
          "name": "Add subscription",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.subscriptionId) { pm.collectionVariables.set('subscriptionId', String(json.subscriptionId)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"planId\": {{planId}}\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/members/subscriptions?memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "subscriptions"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" }
              ]
            }
          }
        },
        {
          "name": "Purchase subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/purchase?subscriptionId={{subscriptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subscriptions", "purchase"],
              "query": [
                { "key": "subscriptionId", "value": "{{subscriptionId}}", "description": "Subscription ID" }
              ]
            }
          }
        },
        {
          "name": "Book a session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.bookingId) { pm.collectionVariables.set('bookingId', String(json.bookingId)); }",
                  "if (json.sessionId) { pm.collectionVariables.set('sessionId', String(json.sessionId)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sessionId\": {{sessionId}}\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/members/bookings?memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "bookings"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" }
              ]
            }
          }
        },
        {
          "name": "Get current subscription",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/members/subscriptions/current?memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "subscriptions", "current"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" }
              ]
            }
          }
        },
        {
          "name": "Get upcoming bookings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/members/bookings/upcoming?memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "bookings", "upcoming"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" }
              ]
            }
          }
        },
        {
          "name": "Get cancelled bookings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/members/bookings/cancelled?memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "bookings", "cancelled"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" }
              ]
            }
          }
        },
        {
          "name": "Get payment history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/members/payments?memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "payments"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List all members",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members" }
        },
        {
          "name": "List members with active subscription",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members/active-subscriptions" }
        },
        {
          "name": "List members expiring soon",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/members/expiring-soon?days={{days}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "expiring-soon"],
              "query": [
                { "key": "days", "value": "{{days}}", "description": "Days until the subscription end date" }
              ]
            }
          }
        },
        {
          "name": "Get member",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/members?memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" }
              ]
            }
          }
        },
        {
          "name": "Delete member",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/members?memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Scheduled upcoming sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/sessions/upcoming" }
        },
        {
          "name": "Completed sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/sessions/completed" }
        },
        {
          "name": "Cancelled sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/sessions/cancelled" }
        },
        {
          "name": "Cancel session",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/cancel?sessionId={{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "cancel"],
              "query": [
                { "key": "sessionId", "value": "{{sessionId}}", "description": "Session ID" }
              ]
            }
          }
        },
        {
          "name": "Delete session",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/sessions?sessionId={{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions"],
              "query": [
                { "key": "sessionId", "value": "{{sessionId}}", "description": "Session ID" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "List member bookings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/members/bookings?memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "bookings"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" }
              ]
            }
          }
        },
        {
          "name": "List member cancelled bookings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/members/bookings/cancelled?memberId={{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "bookings", "cancelled"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" }
              ]
            }
          }
        },
        {
          "name": "Cancel booking by member",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/members/bookings/cancel?memberId={{memberId}}&bookingId={{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "bookings", "cancel"],
              "query": [
                { "key": "memberId", "value": "{{memberId}}", "description": "Member ID" },
                { "key": "bookingId", "value": "{{bookingId}}", "description": "Booking ID" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard (admin)",
      "item": [
        {
          "name": "Most booked service types",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/dashboard/most-booked-service-types" }
        },
        {
          "name": "Most cancelled sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/dashboard/most-cancelled-sessions" }
        },
        {
          "name": "Revenue per month",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard/monthly-revenue?month={{month}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard", "monthly-revenue"],
              "query": [
                { "key": "month", "value": "{{month}}", "description": "Month number 1-12" },
                { "key": "year", "value": "{{year}}", "disabled": true, "description": "Optional year. Tick to include." }
              ]
            }
          }
        },
        {
          "name": "Revenue per month for a year",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard/monthly-revenue?year={{year}}&month={{month}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard", "monthly-revenue"],
              "query": [
                { "key": "year", "value": "{{year}}", "description": "Calendar year" },
                { "key": "month", "value": "{{month}}", "description": "Month number 1-12" }
              ]
            }
          }
        },
        {
          "name": "Revenue per year",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard/yearly-revenue?year={{year}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard", "yearly-revenue"],
              "query": [
                { "key": "year", "value": "{{year}}", "description": "Calendar year" }
              ]
            }
          }
        }
      ]
    }
  ]
}

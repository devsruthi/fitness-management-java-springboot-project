{
  "info": {
    "name": "Health Club Operations REST API",
    "description": "Import into Postman (File → Import). Start the Spring Boot app first so requests go to http://localhost:8080.\n\nRun Catalogue first, then Member workflow from top to bottom.\nRegister and login use the same member (alex.tester@example.com / Alex@123). If register fails because the email already exists, skip it and continue from login.\nRegister/login save memberId. Add subscription saves subscriptionId for purchase and booking.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "memberId", "value": "1" },
    { "key": "planId", "value": "1" },
    { "key": "subscriptionId", "value": "35" },
    { "key": "sessionId", "value": "1" }
  ],
  "item": [
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "List active plans",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/subscription-plans"
          }
        },
        {
          "name": "List service types",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/service-types"
          }
        },
        {
          "name": "List scheduled sessions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sessions"
          }
        }
      ]
    },
    {
      "name": "Member workflow",
      "item": [
        {
          "name": "Register member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.memberId) {",
                  "  pm.collectionVariables.set('memberId', String(json.memberId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Tester\",\n  \"emailId\": \"alex.tester@example.com\",\n  \"password\": \"Alex@123\",\n  \"phoneNo\": \"1511111111\",\n  \"dateOfBirth\": \"1998-05-12\"\n}"
            },
            "url": "{{baseUrl}}/api/members/register"
          }
        },
        {
          "name": "Login member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.memberId) {",
                  "  pm.collectionVariables.set('memberId', String(json.memberId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailId\": \"alex.tester@example.com\",\n  \"password\": \"Alex@123\"\n}"
            },
            "url": "{{baseUrl}}/api/members/login"
          }
        },
        {
          "name": "Add subscription",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.subscriptionId) {",
                  "  pm.collectionVariables.set('subscriptionId', String(json.subscriptionId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/members/{{memberId}}/subscriptions"
          }
        },
        {
          "name": "Purchase subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\"\n}"
            },
            "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/purchase"
          }
        },
        {
          "name": "Book a session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/members/{{memberId}}/bookings"
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List all members",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members"
          }
        },
        {
          "name": "Get member",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members/{{memberId}}"
          }
        }
      ]
    },
    {
      "name": "Sessions and bookings",
      "item": [
        {
          "name": "List member bookings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/members/{{memberId}}/bookings"
          }
        },
        {
          "name": "Cancel session",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/cancel"
          }
        }
      ]
    }
  ]
}
